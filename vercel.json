{
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=dev",
  "outputDirectory": "build/client",
  "framework": null,
  "routes": [
    {
      "src": "/magic-links/?",
      "status": 308,
      "headers": {
        "Location": "/contractor-link"
      }
    },
    {
      "src": "/m/[^/]+(?:/.*)?",
      "dest": "/__spa-fallback.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "private, no-store",
        "Referrer-Policy": "no-referrer"
      }
    },
    {
      "src": "/downloads/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/.well-known/apple-app-site-association",
      "headers": {
        "Content-Type": "application/json"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/features/",
      "status": 308,
      "headers": {
        "Location": "/features"
      }
    },
    {
      "src": "/features",
      "dest": "/features/index.html"
    },
    {
      "src": "/contractor-link/",
      "status": 308,
      "headers": {
        "Location": "/contractor-link"
      }
    },
    {
      "src": "/contractor-link",
      "dest": "/contractor-link/index.html"
    },
    {
      "src": "/floor-plans/",
      "status": 308,
